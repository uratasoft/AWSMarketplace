{
  "family": "flask-api-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::773181940404:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "flask-api",
      "image": "773181940404.dkr.ecr.ap-northeast-1.amazonaws.com/flask-api:latest",
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ],
      "essential": true
    }
  ]
}
